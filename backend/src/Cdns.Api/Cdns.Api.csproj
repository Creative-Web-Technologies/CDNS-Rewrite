  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cdns.Application\Cdns.Application.csproj" />
    <ProjectReference Include="..\Cdns.Infrastructure\Cdns.Infrastructure.csproj" />
  </ItemGroup>

</Project>
